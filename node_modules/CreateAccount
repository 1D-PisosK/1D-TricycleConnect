<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Tricycle Connect - Sign Up</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, sans-serif;
            background-color: white;
            color: #285b27;

            min-height: 100vh;

            display: flex;
            justify-content: center;
            align-items: center;
        }

        .container {
            width: 90%;
            max-width: 900px;
            padding: 40px 20px;
        }

        /* Logo */
        .logo-section {
            text-align: center;
            margin-bottom: 30px;
        }

        .logo {
            width: 300px;
            max-width: 60%;
            height: auto;
        }

        .logo-section h1 {
            font-size: 58px;
            line-height: 1.05;
            font-weight: bold;
            color: #17621d;
            margin-top: 10px;
        }

        /* Welcome Text */
        .welcome {
            margin-bottom: 30px;
        }

        .welcome h2 {
            font-size: 42px;
            color: #17621d;
            margin-bottom: 5px;
        }

        .welcome p {
            font-size: 32px;
            color: #285b27;
        }

        /* Input Boxes */
        .input-box {
            width: 90%;
            height: 80px;
            margin: 20px auto;

            background-color: #dfe2df;
            border-radius: 18px;

            display: flex;
            align-items: center;

            padding: 0 25px;
        }

        .icon {
            width: 60px;
            font-size: 30px;
            text-align: center;
        }

        .input-box input {
            width: 100%;
            height: 100%;

            border: none;
            outline: none;

            background: transparent;

            font-size: 25px;
            color: #333;
        }

        .input-box input::placeholder {
            color: #555;
        }

        /* Sign Up Button */
        .signup-button {
            display: block;

            width: 95%;
            height: 80px;

            margin: 30px auto 20px;

            border: none;
            border-radius: 18px;

            background-color: #285b27;
            color: white;

            font-size: 30px;

            cursor: pointer;
        }

        .signup-button:hover {
            background-color: #1f481f;
        }

        /* OR */
        .or-container {
            width: 90%;
            margin: 20px auto;

            display: flex;
            align-items: center;
            gap: 25px;
        }

        .or-container span {
            height: 2px;
            background-color: #333;
            flex: 1;
        }

        .or-container p {
            font-size: 28px;
            color: #285b27;
        }

        /* Google Button */
        .google-button {
            width: 90%;
            height: 75px;

            margin: 20px auto;

            display: flex;
            justify-content: center;
            align-items: center;
            gap: 20px;

            border: none;
            border-radius: 18px;

            background-color: #dfe2df;

            font-size: 25px;
            font-weight: bold;

            color: #333;

            cursor: pointer;
        }

        .google-button:hover {
            background-color: #d2d5d2;
        }

        .google-logo {
            font-size: 35px;
            font-weight: bold;
            color: #4285F4;
        }

        /* Login */
        .login-text {
            text-align: center;

            margin-top: 40px;

            font-size: 25px;

            color: #333;
        }

        .login-text a {
            color: #285b27;

            font-weight: bold;

            text-decoration: none;
        }

        .login-text a:hover {
            text-decoration: underline;
        }

        /* Message */
        #message {
            text-align: center;

            margin-top: 20px;

            font-size: 20px;

            font-weight: bold;
        }

        /* Mobile */
        @media (max-width: 600px) {

            .container {
                width: 100%;
                padding: 25px 15px;
            }

            .logo {
                width: 180px;
            }

            .logo-section h1 {
                font-size: 42px;
            }

            .welcome h2 {
                font-size: 30px;
            }

            .welcome p {
                font-size: 22px;
            }

            .input-box {
                width: 100%;
                height: 65px;
            }

            .input-box input {
                font-size: 19px;
            }

            .signup-button {
                width: 100%;
                height: 65px;
                font-size: 23px;
            }

            .google-button {
                width: 100%;
                height: 65px;
                font-size: 19px;
            }

            .login-text {
                font-size: 19px;
            }
        }
    </style>
</head>

<body>

    <div class="container">

        <!-- Logo -->
        <div class="logo-section">

            <img
                src="https://trykecorp.com/assets/img/Comp_Trike_Logo_B_0v2.png"
                alt="Tricycle Connect Logo"
                class="logo"
            >

            <h1>
                Tricycle<br>
                Connect
            </h1>

        </div>


        <!-- Welcome Text -->
        <div class="welcome">

            <h2>Create an account</h2>

            <p>for a better ride experience.</p>

        </div>


        <!-- Sign Up Form -->
        <form id="signupForm">

            <!-- Full Name -->
            <div class="input-box">

                <span class="icon">👤</span>

                <input
                    type="text"
                    id="fullName"
                    name="fullName"
                    placeholder="Full Name"
                    required
                >

            </div>


            <!-- Mobile Number / Email -->
            <div class="input-box">

                <span class="icon">📞</span>

                <input
                    type="text"
                    id="contact"
                    name="contact"
                    placeholder="Mobile Number/Email"
                    required
                >

            </div>


            <!-- Password -->
            <div class="input-box">

                <span class="icon">🔒</span>

                <input
                    type="password"
                    id="password"
                    name="password"
                    placeholder="Password"
                    required
                >

            </div>


            <!-- Sign Up -->
            <button
                type="submit"
                class="signup-button"
            >
                Sign Up
            </button>

        </form>


        <!-- OR -->
        <div class="or-container">

            <span></span>

            <p>or</p>

            <span></span>

        </div>


        <!-- Google -->
        <button
            type="button"
            id="googleButton"
            class="google-button"
        >

            <span class="google-logo">G</span>

            <span>Continue with Google</span>

        </button>


        <!-- Login -->
        <p class="login-text">

            Already have an account?

            <a href="#" id="loginLink">
                Log in
            </a>

        </p>


        <!-- Message -->
        <p id="message"></p>

    </div>


    <script>

        // Get the form
        const signupForm =
            document.getElementById("signupForm");


        // Get the input fields
        const fullNameInput =
            document.getElementById("fullName");

        const contactInput =
            document.getElementById("contact");

        const passwordInput =
            document.getElementById("password");


        // Get buttons and message
        const googleButton =
            document.getElementById("googleButton");

        const loginLink =
            document.getElementById("loginLink");

        const message =
            document.getElementById("message");


        // SIGN UP
        signupForm.addEventListener("submit", function(event) {

            event.preventDefault();


            // Proper data types
            const fullName = fullNameInput.value.trim();

            const contact = contactInput.value.trim();

            const password = passwordInput.value;


            // Check empty fields
            if (
                fullName === "" ||
                contact === "" ||
                password === ""
            ) {

                message.textContent =
                    "Please complete all fields.";

                message.style.color = "red";

                return;
            }


            // Check password length
            if (password.length < 6) {

                message.textContent =
                    "Password must be at least 6 characters.";

                message.style.color = "red";

                return;
            }


            // Successful registration
            message.textContent =
                "Account created successfully!";

            message.style.color =
                "#285b27";


            // Show entered data in Console
            console.log("Full Name:", fullName);

            console.log(
                "Mobile Number/Email:",
                contact
            );

            console.log(
                "Password:",
                password
            );

        });


        // GOOGLE BUTTON
        googleButton.addEventListener("click", function() {

            message.textContent =
                "Google sign-in selected.";

            message.style.color =
                "#285b27";

        });


        // LOGIN
        loginLink.addEventListener("click", function(event) {

            event.preventDefault();

            message.textContent =
                "Login page selected.";

            message.style.color =
                "#285b27";

        });

    </script>

</body>
</html>